<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ── Control: tiempo en pantalla y filtro +18 ─────────────────── -->

        <!-- Se pone encima de la app bloqueada. Sin animación y fuera de recientes. -->
        <activity
            android:name=".control.PantallaBloqueo"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/AppTheme.Bloqueo" />

        <!-- Vigila qué app está adelante para aplicar límites y el filtro. -->
        <service
            android:name=".control.VigilanteAccesibilidad"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad_lykari" />
        </service>

        <!-- VPN local solo-DNS del filtro +18. -->
        <service
            android:name=".control.FiltroDns"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Admin de dispositivo: frena la desinstalación por impulso. -->
        <receiver
            android:name=".control.AdminReceptor"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/admin_lykari" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Relevanta el filtro DNS tras reiniciar. -->
        <receiver
            android:name=".control.ArranqueReceptor"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Enciende/apaga No molestar en cada frontera de horario de los modos. -->
        <receiver
            android:name=".control.AlarmaModos"
            android:exported="false" />
    </application>

    <!--
        Desde Android 11 las apps no ven los paquetes de otras salvo que lo
        declaren. Sin este bloque, SpeechRecognizer no encuentra el servicio
        de reconocimiento y el dictado falla en silencio en el teléfono,
        aunque en el navegador funcione.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Permissions -->

    <!-- Llamar a la API de la IA. Nada más sale del teléfono. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permite que Lykari entregue su APK descargado al instalador de
         Android. El sistema siempre pide la confirmación final: la app nunca
         se instala sola ni abre el navegador. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Grabar las capturas de voz y el audio de cierre de sesión. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Imprescindible aunque no lo parezca: al abrir el micrófono, el motor
         de la WebView cambia el modo de audio del sistema. Sin este permiso
         ese cambio falla y getUserMedia devuelve NotReadableError, con el
         permiso de micrófono ya concedido. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Recordatorio del diario a las 8:00 pm y alarmas de los pendientes.
         POST_NOTIFICATIONS lo pide Android 13 en adelante; los dos de alarma
         son los que hacen que el aviso llegue a su hora con la app cerrada. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Reprogramar los avisos después de reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Control: tiempo en pantalla y filtro +18 ─────────────────────── -->
    <!-- Leer el tiempo real por app (se concede en Ajustes → Acceso al uso). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- APK personal fuera de Play Store: ver la lista de apps para poner límites. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Dibujar la pantalla de bloqueo por encima de otras apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- VPN local solo-DNS del filtro +18. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Silencio automático (No molestar) en los modos Sueño, Estudio y En clase. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
</manifest>
